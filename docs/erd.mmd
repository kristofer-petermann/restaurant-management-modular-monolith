erDiagram

    %% ========================
    %% Identity Layer
    %% ========================

    User {
        string Id PK
        string UserName
        string Email
    }

    Role {
        string Id PK
        string Name
    }

    UserRole {
        string UserId FK
        string RoleId FK
    }

    User ||--o{ UserRole : has
    Role ||--o{ UserRole : assigned


    %% ========================
    %% Domain Layer
    %% ========================

    Restaurant {
        int Id PK
        string Name
        string Description
        string Phone
        string Email
    }

    Address {
        int Id PK
        string Street
        string City
        string PostalCode
        string Country
        string UserId FK
    }

    OpeningHour {
        int Id PK
        int RestaurantId FK
        int DayOfWeek
        time OpenTime
        time CloseTime
    }

    RestaurantUser {
        int Id PK
        int RestaurantId FK
        string UserId FK
        string Role
    }

    Menu {
        int Id PK
        int RestaurantId FK
        string Name
        boolean IsActive
    }

    MenuCategory {
        int Id PK
        int MenuId FK
        string Name
    }

    MenuItem {
        int Id PK
        int MenuCategoryId FK
        string Name
        string Description
        decimal Price
        boolean IsAvailable
        string ImageUrl
    }

    Order {
        int Id PK
        string UserId FK
        int RestaurantId FK
        datetime CreatedAt
        datetime PickupTime
        string Status
        decimal TotalPrice
    }

    OrderRow {
        int Id PK
        int OrderId FK
        int MenuItemId FK
        int Quantity
        decimal UnitPrice
    }

    Payment {
        int Id PK
        int OrderId FK
        decimal Amount
        string PaymentMethod
        datetime PaidAt
    }

    Review {
        int Id PK
        int RestaurantId FK
        string UserId FK
        int Rating
        string Comment
        datetime CreatedAt
    }

    %% ========================
    %% Relationships
    %% ========================

    Restaurant ||--o{ OpeningHour : has
    Restaurant ||--o{ Menu : contains
    Restaurant ||--o{ Order : receives
    Restaurant ||--o{ Review : receives
    Restaurant ||--o{ RestaurantUser : managed_by

    User ||--o{ Order : places
    User ||--o{ Review : writes
    User ||--o{ RestaurantUser : manages

    Menu ||--o{ MenuCategory : groups
    MenuCategory ||--o{ MenuItem : contains

    Order ||--o{ OrderRow : includes
    Order ||--|| Payment : has

    MenuItem ||--o{ OrderRow : referenced_in