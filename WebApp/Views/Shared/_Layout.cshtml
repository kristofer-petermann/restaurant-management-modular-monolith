<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.Name">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WebApp</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">@(App.Resources.Views.Home.Homepage)</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button"
                               data-bs-toggle="dropdown" aria-expanded="false">
                                @(App.Resources.Views.Home.User)
                            </a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-area="" asp-controller="Addresses" asp-action="Index">@(App.Resources.Views.Home.Addresses)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="MenuCategories" asp-action="Index">@(App.Resources.Views.Home.MenuCategories)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="MenuItems" asp-action="Index">@(App.Resources.Views.Home.MenuItems)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Menus" asp-action="Index">@(App.Resources.Views.Home.Menus)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="OpeningHours" asp-action="Index">@(App.Resources.Views.Home.OpeningHours)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="OrderRows" asp-action="Index">@(App.Resources.Views.Home.OrderRows)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Orders" asp-action="Index">@(App.Resources.Views.Home.Orders)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Payments" asp-action="Index">@(App.Resources.Views.Home.Payments)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Restaurants" asp-action="Index">@(App.Resources.Views.Home.Restaurants)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="RestaurantUsers" asp-action="Index">@(App.Resources.Views.Home.RestaurantUsers)</a></li>
                                <li><a class="dropdown-item" asp-area="" asp-controller="Reviews" asp-action="Index">@(App.Resources.Views.Home.Reviews)</a></li>
                            </ul>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">@(App.Resources.Views.Home.Privacy)</a>
                    </li>

                    @if (User.IsInRole("root"))
                    {
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                        </li>
                    }
                    
                    <partial name="_LanguageSelection"/>
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        | @(Thread.CurrentThread.CurrentUICulture.Name)
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
