@using Base.Helpers
@model IEnumerable<Shared.Contracts.Restaurants.ReviewDto>

@{
    ViewData["Title"] = "Index";
    var canCreate = User.Identity?.IsAuthenticated == true;
    var currentUserId = canCreate ? User.GetUserId() : Guid.Empty;
}

<h1>Index</h1>

@if (canCreate)
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AppUser!.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Restaurant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rating)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Comment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Summary)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.AppUser?.Email ?? item.UserId.ToString())
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Restaurant!.RestaurantName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rating)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Comment)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Summary)
            </td>
            <td>
                @{
                    var canManageRow = User.IsInRole("root") || User.IsInRole("admin") || item.UserId == currentUserId;
                }
                @if (canManageRow)
                {
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    @:|
                }
                <a asp-action="Details" asp-route-id="@item.Id">Details</a>
                @if (canManageRow)
                {
                    @:|
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
