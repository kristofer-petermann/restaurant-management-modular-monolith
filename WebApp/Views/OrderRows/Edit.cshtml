@model WebApp.ViewModels.OrderRow.OrderRowEditViewModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>OrderRow</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="OrderId" class="control-label"></label>
                <select asp-for="OrderId" class="form-control" asp-items="Model.OrderOptions"></select>
                <span asp-validation-for="OrderId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MenuItemId" class="control-label"></label>
                <select asp-for="MenuItemId" class="form-control" asp-items="Model.MenuItemOptions"></select>
                <span asp-validation-for="MenuItemId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Quantity" class="control-label"></label>
                <input asp-for="Quantity" class="form-control" />
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UnitPrice" class="control-label"></label>
                <input asp-for="UnitPrice" class="form-control" />
                <span asp-validation-for="UnitPrice" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Summary" class="control-label"></label>
                <input asp-for="Summary" class="form-control" />
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const orderSelect = document.getElementById("OrderId");
            const menuItemSelect = document.getElementById("MenuItemId");
            const unitPriceInput = document.getElementById("UnitPrice");
            const getMenuItemsUrl = '@Url.Action("GetMenuItemsForOrder", "OrderRows")';
            const getMenuItemPriceUrl = '@Url.Action("GetMenuItemPrice", "OrderRows")';

            if (!orderSelect || !menuItemSelect || !unitPriceInput) return;

            const refreshMenuItems = async (selectedMenuItemId = null) => {
                if (!orderSelect.value) {
                    menuItemSelect.innerHTML = "";
                    return;
                }

                const url = `${getMenuItemsUrl}?orderId=${encodeURIComponent(orderSelect.value)}`;
                const response = await fetch(url);
                if (!response.ok) return;

                const items = await response.json();
                menuItemSelect.innerHTML = "";

                for (const item of items) {
                    const option = document.createElement("option");
                    option.value = item.value;
                    option.text = item.text;
                    if (selectedMenuItemId && String(item.value) === String(selectedMenuItemId)) {
                        option.selected = true;
                    }
                    menuItemSelect.appendChild(option);
                }

                if (menuItemSelect.options.length > 0 && menuItemSelect.selectedIndex < 0) {
                    menuItemSelect.selectedIndex = 0;
                }
            };

            const updatePrice = async () => {
                if (!orderSelect.value || !menuItemSelect.value) return;

                const url = `${getMenuItemPriceUrl}?orderId=${encodeURIComponent(orderSelect.value)}&menuItemId=${encodeURIComponent(menuItemSelect.value)}`;
                const response = await fetch(url);
                if (!response.ok) return;

                const data = await response.json();
                unitPriceInput.value = data.price;
            };

            orderSelect.addEventListener("change", async () => {
                await refreshMenuItems();
                await updatePrice();
            });

            menuItemSelect.addEventListener("change", updatePrice);

            refreshMenuItems(menuItemSelect.value);
        });
    </script>
}
