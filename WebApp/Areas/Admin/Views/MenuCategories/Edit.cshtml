@model WebApp.Areas.Admin.ViewModels.MenuCategory.MenuCategoryEditViewModel

@{
    ViewData["Title"] = "Edit category";
}

<section class="admin-page-header">
    <div>
        <h1>Edit category</h1>
        <p>Update category name, menu assignment, and summary.</p>
    </div>
</section>
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MenuId" class="control-label"></label>
                <select asp-for="MenuId" class="form-control" asp-items="Model.MenuOptions"></select>
                <span asp-validation-for="MenuId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Summary" class="control-label"></label>
                <input asp-for="Summary" class="form-control" />
                <span asp-validation-for="Summary" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="Id" />
            <div class="admin-form-actions">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a class="admin-button admin-button-secondary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
