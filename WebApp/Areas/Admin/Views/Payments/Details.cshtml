@model Shared.Contracts.Orders.PaymentDto

@{
    ViewData["Title"] = "Payment details";
    var canManage = User.Identity?.IsAuthenticated == true && (User.IsInRole("root") || User.IsInRole("admin"));
}

<section class="admin-page-header">
    <div>
        <h1>Payment details</h1>
        <p>Payment amount, method, status, timing, and order link.</p>
    </div>
    <div class="admin-page-actions">
        @if (canManage)
        {
            <a class="admin-button admin-button-primary" asp-action="Edit" asp-route-id="@Model!.Id">Edit payment</a>
        }
        <a class="admin-button admin-button-secondary" asp-action="Index">Back to payments</a>
    </div>
</section>

<div>
    <h4>Payment</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order)
        </dt>
        <dd class = "col-sm-10">
            @($"{Model!.Order?.User?.Email ?? Model!.Order?.UserId.ToString()} - {Model!.Order?.CreatedAt:yyyy-MM-dd HH:mm}")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Amount)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Amount)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentStatus)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentStatus)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaymentMethod)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaymentMethod)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.PaidAt)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.PaidAt)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Summary)
        </dd>
    </dl>
</div>
