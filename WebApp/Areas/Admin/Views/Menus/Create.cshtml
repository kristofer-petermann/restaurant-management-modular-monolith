@model WebApp.Areas.Admin.ViewModels.Menu.MenuCreateViewModel

@{
    ViewData["Title"] = "Create menu";
}

<section class="admin-page-header">
    <div>
        <h1>Create menu</h1>
        <p>Add a menu and connect it to a restaurant.</p>
    </div>
</section>
<div class="row">
    <div class="col-md-4">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group">
            <label asp-for="RestaurantId" class="control-label"></label>
            <select asp-for="RestaurantId" class="form-select" asp-items="Model.RestaurantOptions"></select>
            <span asp-validation-for="RestaurantId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Name" class="control-label"></label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group form-check">
            <input class="form-check-input" asp-for="IsActive" />
            <label class="form-check-label" asp-for="IsActive"></label>
        </div>
        <div class="form-group">
            <label asp-for="Summary" class="control-label"></label>
            <input asp-for="Summary" class="form-control" />
            <span asp-validation-for="Summary" class="text-danger"></span>
        </div>
        <div class="admin-form-actions">
            <input type="submit" value="Create menu" class="btn btn-primary" />
            <a class="admin-button admin-button-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
