@model IEnumerable<Shared.Contracts.Restaurants.MenuDto>

@{
    ViewData["Title"] = App.Resources.Views.Home.Menus;
}

<section class="admin-page-header">
    <div>
        <h1>@(App.Resources.Views.Home.Menus)</h1>
        <p>Manage restaurant menus, availability, and menu summaries.</p>
    </div>
    <div class="admin-page-actions">
        <a class="admin-button admin-button-primary" asp-action="Create">New menu</a>
    </div>
</section>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.Restaurant)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Name)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsActive)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Summary)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.Restaurant!.RestaurantName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Name)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.IsActive)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Summary)
        </td>
        <td>
            <div class="admin-table-actions">
                <a class="admin-row-action" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="admin-row-action" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="admin-row-action danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </div>
        </td>
    </tr>
}
    </tbody>
</table>
