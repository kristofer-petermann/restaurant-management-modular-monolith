@model IEnumerable<Shared.Contracts.Identity.RestaurantUserReadDto>

@{
    ViewData["Title"] = App.Resources.Views.Home.RestaurantUsers;
}

<section class="admin-page-header">
    <div>
        <h1>@(App.Resources.Views.Home.RestaurantUsers)</h1>
        <p>Control which users are connected to restaurant management roles.</p>
    </div>
    <div class="admin-page-actions">
        <a class="admin-button admin-button-primary" asp-action="Create">New restaurant user</a>
    </div>
</section>
<table class="table">
    <thead>
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.RestaurantName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UserEmail)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.UserRole)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Role)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Summary)
        </th>
        <th></th>
    </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>
            @(item.RestaurantName ?? item.RestaurantId.ToString())
        </td>
        <td>
            @(item.UserEmail ?? item.UserId.ToString())
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.UserRole)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Role)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Summary)
        </td>
        <td>
            <div class="admin-table-actions">
                <a class="admin-row-action" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="admin-row-action" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="admin-row-action danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </div>
        </td>
    </tr>
}
    </tbody>
</table>
