@model Shared.Contracts.Restaurants.OpeningHourDto

@{
    ViewData["Title"] = "Opening hour details";
    var canManage = User.Identity?.IsAuthenticated == true && (User.IsInRole("root") || User.IsInRole("admin"));
}

<section class="admin-page-header">
    <div>
        <h1>Opening hour details</h1>
        <p>Restaurant schedule, day, time range, and summary.</p>
    </div>
    <div class="admin-page-actions">
        @if (canManage)
        {
            <a class="admin-button admin-button-primary" asp-action="Edit" asp-route-id="@Model!.Id">Edit opening hour</a>
        }
        <a class="admin-button admin-button-secondary" asp-action="Index">Back to opening hours</a>
    </div>
</section>

<div>
    <h4>OpeningHour</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Restaurant)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Restaurant!.RestaurantName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DayOfWeek)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DayOfWeek)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.OpenTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.OpenTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CloseTime)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CloseTime)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Summary)
        </dd>
    </dl>
</div>
