@model IEnumerable<Shared.Contracts.Orders.OrderDto>

@{
    ViewData["Title"] = App.Resources.Views.Home.Orders;
    var canManage = User.Identity?.IsAuthenticated == true;
}

<section class="admin-page-header">
    <div>
        <h1>@(App.Resources.Views.Home.Orders)</h1>
        <p>Track customer orders, statuses, prices, and pickup timing.</p>
    </div>
    @if (canManage)
    {
        <div class="admin-page-actions">
            <a class="admin-button admin-button-primary" asp-action="Create">New order</a>
        </div>
    }
</section>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.User)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Restaurant)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.OrderStatus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TotalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PickupTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Summary)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.User!.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Restaurant!.RestaurantName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.OrderStatus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TotalPrice)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PickupTime)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Summary)
            </td>
            <td>
                <div class="admin-table-actions">
                    @if (canManage)
                    {
                        <a class="admin-row-action" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                    }
                    <a class="admin-row-action" asp-action="Details" asp-route-id="@item.Id">Details</a>
                    @if (canManage)
                    {
                        <a class="admin-row-action danger" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    }
                </div>
            </td>
        </tr>
}
    </tbody>
</table>
