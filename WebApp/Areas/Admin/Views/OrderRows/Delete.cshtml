@model Shared.Contracts.Orders.OrderRowDto

@{
    ViewData["Title"] = "Delete order row";
}


<section class="admin-danger-panel">
    <h1>Delete order row</h1>
    <p>This action removes the order row record. Review the details before confirming.</p>
</section>
<div>
    <h4>OrderRow</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Order)
        </dt>
        <dd class = "col-sm-10">
            @($"{Model.Order?.User?.Email ?? Model.Order?.UserId.ToString()} - {Model.Order?.CreatedAt:yyyy-MM-dd HH:mm}")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MenuItem)
        </dt>
        <dd class="col-sm-10">
            @(Model.MenuItem?.Name ?? Model.MenuItemId.ToString())
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Quantity)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantity)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.UnitPrice)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.UnitPrice)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Summary)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Summary)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="admin-form-actions">
            <input type="submit" value="Delete order row" class="btn btn-danger" />
            <a class="admin-button admin-button-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
